# ESP32-CAM stream URL (MJPEG)
# Replace with your ESP32-CAM's IP address
VITE_ESP32_STREAM_URL=http://192.168.1.100/stream

# Optional: snapshot endpoint for still captures
VITE_ESP32_SNAPSHOT_URL=http://192.168.1.100/capture

# Stream reconnect delay in milliseconds
VITE_STREAM_RECONNECT_DELAY=3000

# Max reconnect attempts (0 = infinite)
VITE_STREAM_MAX_RETRIES=0
